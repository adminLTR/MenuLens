# Copie para .env e preencha. Este ficheiro é o modelo de produção.

FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=

# Produção: host do MySQL acessível ao contentor/serviço da API
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/menulens?charset=utf8mb4

# O docker compose lê estas variáveis para o serviço db
MYSQL_DATABASE=menulens
MYSQL_USER=menulens
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Desenvolvimento local (Flask na máquina, MySQL no Docker com 3306 publicado):
# DATABASE_URL=mysql+pymysql://menulens:menulens@127.0.0.1:3306/menulens?charset=utf8mb4
# SECRET_KEY=dev-only
#
# Desenvolvimento com docker compose (o host MySQL chama-se "db"):
# DATABASE_URL=mysql+pymysql://menulens:menulens@db:3306/menulens?charset=utf8mb4

# Leitura do cardápio (POST /api/menus/scan). tesseract é o motor do contentor.
# OCR_ENGINE=easyocr exige `pip install easyocr` e mais RAM.
OCR_ENGINE=tesseract
OCR_LANGS=por+eng+spa
OCR_MATCH_THRESHOLD=78
MAX_CONTENT_LENGTH=8388608

# Gemini (plan gratuito). Cree una clave en https://aistudio.google.com/apikey
# y péguela aquí. Docker Compose la inyecta al backend con env_file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
