# Copy to .env and adjust values: cp .env.example .env

APP_ENV=production
SECRET_KEY=change-me

MYSQL_ROOT_PASSWORD=root-change-me
MYSQL_DATABASE=menulens
MYSQL_USER=menulens
MYSQL_PASSWORD=menulens-change-me
MYSQL_PORT_HOST=3306

API_PORT=5000
ADMINER_PORT=8080
CORS_ORIGINS=*

# Base URL the mobile app uses to reach the API.
# Android emulator -> host machine: http://10.0.2.2:5000/api/v1
# Physical device: http://<your-LAN-IP>:5000/api/v1
MOBILE_API_BASE_URL=http://10.0.2.2:5000/api/v1
FLUTTER_VERSION=stable
