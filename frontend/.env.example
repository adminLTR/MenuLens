# Copie para .env e preencha. Este ficheiro é o modelo de produção.
#
# VITE_* entra no bundle no `npm run build`. Mude e volte a construir.

# URL pública da API (o browser chama isto em produção)
VITE_API_URL=https://api.seudominio.com

# Só no `vite` (dev / docker). O proxy encaminha /api e /health.
# Local sem Docker:
# VITE_PROXY_TARGET=http://127.0.0.1:5000
# Docker compose:
# VITE_PROXY_TARGET=http://backend:5000
VITE_PROXY_TARGET=http://127.0.0.1:5000
